# GitHub Action Machine (GTM) - Environment Template
# Copy to .env locally. Never put a real token in this template or commit it.

# === GitHub ===
# Personal Access Token or GitHub App token with:
# - repo (for private) or public_repo
# - actions:write (workflow dispatch)
# - actions:read (status & logs)
GITHUB_TOKEN=replace_with_your_github_token
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-build-runner-repo
# Optional: default branch for workflow
GITHUB_REF=main

# === Cloudflare Worker ===
# Bound in wrangler.toml, not usually in env
# R2_BUCKET=gtm-artifacts
# KV_NAMESPACE=gtm-metadata

# === Frontend ===
# Base URL of the Worker API (no trailing slash)
VITE_API_BASE_URL=https://gtm-api.your-subdomain.workers.dev

# Optional: GitHub Pages base path if deploying under /repo-name/
# VITE_BASE_PATH=/GTM/

# === Security / Limits ===
MAX_UPLOAD_BYTES=104857600
BUILD_TIMEOUT_MINUTES=30
ARTIFACT_RETENTION_DAYS=7
RATE_LIMIT_PER_MINUTE=10

# === Auth (optional, for production) ===
# ADMIN_API_KEY=change-me-to-a-long-random-string
